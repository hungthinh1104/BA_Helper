NODE_ENV=production
WORKSPACE_MODE=dev-single-user
ENABLE_DEV_LOGIN=false
PUBLIC_PREVIEW_MODE=false

POSTGRES_PASSWORD=replace-with-db-password
DATABASE_URL=postgresql://ba_helper:replace-with-db-password@postgres:5432/ba_helper
# Redis requires authentication in production. REDIS_PASSWORD is consumed by the
# redis container; REDIS_URL (used by api/worker) MUST embed the same password.
REDIS_PASSWORD=replace-with-redis-password
REDIS_URL=redis://:replace-with-redis-password@redis:6379
JWT_SECRET=replace-with-at-least-32-random-characters
NEXTAUTH_SECRET=replace-with-at-least-32-random-characters

CORS_ALLOWED_ORIGINS=https://ba-helper.example.com
NEXT_PUBLIC_API_URL=https://api.ba-helper.example.com
INTERNAL_API_URL=http://api:3001

PUBLIC_BETA_RATE_LIMIT_ENABLED=true
PUBLIC_BETA_RATE_LIMIT_MAX=30
PUBLIC_BETA_RATE_LIMIT_WINDOW_MS=60000

AI_PROVIDER=google
GOOGLE_API_KEY=replace-me
GOOGLE_MODEL=gemini-2.5-flash
EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001

BA_HELPER_PRESERVE_SCAN_WORKSPACE=false
NEXT_PUBLIC_USE_MOCK_API=false
