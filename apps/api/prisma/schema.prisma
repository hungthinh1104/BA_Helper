generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum ScanJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanJobStage {
  WAITING
  CLONING_REPO
  RESOLVING_SOURCE_REF
  DETECTING_PROJECT
  FILTERING_FILES
  EXTRACTING_ARTIFACTS
  BUILDING_GRAPH
  GENERATING_SUMMARIES
  DONE
}

enum SnapshotCoverageStatus {
  READY
  PARTIAL
}

enum SnapshotIndexStatus {
  NOT_INDEXED
  LEXICAL_READY
  VECTOR_INDEXING
  VECTOR_READY
  VECTOR_FAILED
}

enum RepositoryProfileDomain {
  BOOKING
  PAYMENT
  REFUND
  NOTIFICATION
  INVENTORY
  CUSTOM
  UNKNOWN
}

enum RepositoryProfileLanguage {
  TYPESCRIPT
  JAVA
  GO
  PYTHON
  CSHARP
  PHP
  RUBY
  UNKNOWN
}

enum RepositoryProfileFramework {
  NESTJS
  SPRING_BOOT
  GENERIC_TYPESCRIPT
  NET_HTTP
  GIN
  FASTAPI
  ASPNETCORE
  LARAVEL
  RAILS
  UNKNOWN
}

enum RepositoryProfileArchitectureStyle {
  MODULAR_MONOLITH
  LAYERED
  UNKNOWN
}

enum ResolvedRefType {
  BRANCH
  TAG
  COMMIT
}

enum RequirementReadinessStatus {
  DRAFT
  READY_FOR_ANALYSIS
  NEEDS_CLARIFICATION
  ARCHIVED
}

enum ImpactAnalysisStatus {
  QUEUED
  RUNNING
  WAITING_FOR_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

enum ImpactAnalysisStage {
  WAITING
  RETRIEVING_EVIDENCE
  EXPANDING_GRAPH
  RUNNING_AI_REASONING
  GENERATING_INSIGHTS
  GENERATING_DOCUMENTS
  DONE
}

enum EvidenceSourceType {
  CODE
  TEST
  STATIC_ANALYSIS
  REQUIREMENT_INPUT
  COVERAGE
  HUMAN_NOTE
}

enum InsightCertainty {
  EVIDENCED
  INFERRED
  UNKNOWN
  CONFLICTING
}

enum InsightType {
  CLAIM
  UNKNOWN
  QUESTION
  ACCEPTANCE_CRITERIA
  QA_SCENARIO
}

enum TraceabilityLinkType {
  AFFECTED
  RELATED
}

enum DocumentType {
  IMPACT_REPORT
}

enum DocumentStatus {
  DRAFT
  APPROVED
  /// @description STALE is a projection-only state derived at runtime. It is never persisted to the database.
  STALE
}

enum DocumentJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum LocalizationStatus {
  QUEUED
  COMPLETED
  FAILED
}

enum ClarificationStatus {
  OPEN
  ANSWERED
  DISMISSED
  CONVERTED_TO_REVISION
}

enum ReviewClarificationStatus {
  OPEN
  ANSWERED
  CANCELLED
}

enum ReviewStatus {
  NEEDS_REVIEW
  CONFIRMED
  REJECTED
}

enum AnalysisReviewDecisionValue {
  ACCEPTED
  REJECTED
  NEEDS_MORE_CLARIFICATION
}

enum TraceabilityReviewDecisionValue {
  ACCEPTED
  REJECTED
  NEEDS_REVIEW
  NEEDS_MORE_EVIDENCE
}

enum TraceabilityLinkBasis {
  EVIDENCED
  INFERRED
}

enum DomainPackCapabilityStatus {
  STABLE
  PARTIAL
  EXPERIMENTAL
  FALLBACK
}

enum DomainPackSelectionSource {
  EXPLICIT
  REPOSITORY_PROFILE
  FALLBACK
}

enum DependencyEdgeType {
  CALLS
  REFERENCES
  IMPORTS
  TESTS
}

enum UserRole {
  ADMIN
  REVIEWER
  VIEWER
}

enum ProjectRole {
  OWNER
  MAINTAINER
  ANALYST
  REVIEWER
  VIEWER
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String?
  passwordHash       String?   @map("password_hash")
  credentialsVersion Int       @default(1) @map("credentials_version")
  disabledAt         DateTime? @map("disabled_at")
  role               UserRole  @default(REVIEWER)
  selectedProjectId  String?   @map("selected_project_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  reviewDecisions             AnalysisReviewDecision[]
  traceabilityReviewDecisions TraceabilityReviewDecision[]
  mergedReportReviewDecisions MergedMultiRepoReportReviewDecision[]
  createdClarifications       ReviewClarificationRequest[]          @relation("ClarificationCreatedBy")
  answeredClarifications      ReviewClarificationRequest[]          @relation("ClarificationAnsweredBy")
  projectMemberships          ProjectMember[]
  selectedProject             Project?                              @relation("SelectedProject", fields: [selectedProjectId], references: [id], onDelete: SetNull)
  createdMultiRepoRuns        MultiRepoAnalysisRun[]                @relation("CreatedMultiRepoRuns")
  reviewedReportSnapshots     ReviewedReportSnapshot[]

  @@index([selectedProjectId])
  @@map("user")
}

model Project {
  id              String                 @id @default(uuid())
  name            String
  repositories    Repository[]
  requirements    Requirement[]
  members         ProjectMember[]
  selectedByUsers User[]                 @relation("SelectedProject")
  multiRepoRuns   MultiRepoAnalysisRun[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
}

model ProjectMember {
  id        String      @id @default(uuid()) @db.Uuid
  projectId String      @map("project_id")
  userId    String      @map("user_id") @db.Uuid
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@index([projectId])
  @@map("project_member")
}

model Repository {
  id              String               @id @default(uuid())
  projectId       String
  canonicalUrl    String
  targets         RepositoryTarget[]
  snapshots       RepositorySnapshot[]
  scanJobs        ScanJob[]
  analyses        ImpactAnalysis[]
  embeddingChunks EmbeddingChunk[]     @relation("EmbeddingChunkRepository")
  project         Project              @relation(fields: [projectId], references: [id])
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([projectId, canonicalUrl])
  @@unique([id, projectId])
}

model RepositoryTarget {
  id                      String           @id @default(uuid())
  repositoryId            String
  targetKey               String
  requestedRef            String
  resolvedRefType         ResolvedRefType
  latestObservedCommitSha String
  lastObservedAt          DateTime
  repository              Repository       @relation(fields: [repositoryId], references: [id])
  analyses                ImpactAnalysis[]
  scanJobs                ScanJob[]
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@unique([repositoryId, targetKey])
  @@unique([id, repositoryId])
}

model RepositorySnapshot {
  id              String                 @id @default(uuid())
  repositoryId    String
  commitSha       String
  analyzerVersion String
  coverageStatus  SnapshotCoverageStatus
  indexStatus     SnapshotIndexStatus    @default(NOT_INDEXED)
  diagnostics     Json                   @default("[]")
  profile         RepositoryProfile?
  artifacts       CodeArtifact[]
  edges           DependencyEdge[]
  evidences       Evidence[]
  analyses        ImpactAnalysis[]
  scanJobs        ScanJob[]
  embeddingChunks EmbeddingChunk[]       @relation("EmbeddingChunkSnapshot")
  repository      Repository             @relation(fields: [repositoryId], references: [id])
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([repositoryId, commitSha, analyzerVersion])
  @@unique([id, repositoryId])
  @@unique([id, repositoryId, commitSha])
}

model RepositoryProfile {
  id                String                             @id @default(uuid())
  snapshotId        String                             @unique
  domain            RepositoryProfileDomain
  language          RepositoryProfileLanguage
  framework         RepositoryProfileFramework
  architectureStyle RepositoryProfileArchitectureStyle @map("architecture_style")
  sourceRoots       Json                               @map("source_roots")
  testRoots         Json                               @map("test_roots")
  diagnostics       Json?
  profileVersion    String                             @map("profile_version")
  createdAt         DateTime                           @default(now()) @map("created_at")
  updatedAt         DateTime                           @updatedAt @map("updated_at")
  snapshot          RepositorySnapshot                 @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@map("repository_profile")
}

model ScanJob {
  id             String              @id @default(uuid())
  repositoryId   String
  requestKey     String
  requestedRef   String?
  status         ScanJobStatus
  stage          ScanJobStage
  progress       Int                 @default(0)
  diagnostics    Json                @default("[]")
  errorCode      String?
  errorMessage   String?
  sourceTargetId String?
  snapshotId     String?
  repository     Repository          @relation(fields: [repositoryId], references: [id])
  sourceTarget   RepositoryTarget?   @relation(fields: [sourceTargetId, repositoryId], references: [id, repositoryId], onDelete: Restrict, onUpdate: Cascade)
  snapshot       RepositorySnapshot? @relation(fields: [snapshotId, repositoryId], references: [id, repositoryId], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([repositoryId, requestKey])
}

model CodeArtifact {
  id                String             @id @default(uuid())
  snapshotId        String
  artifactKey       String
  name              String
  artifactType      String
  universalKind     String             @default("UNKNOWN") @map("universal_kind")
  filePath          String
  startLine         Int?
  endLine           Int?
  language          String?
  contentHash       String?
  metadata          Json?
  snapshot          RepositorySnapshot @relation(fields: [snapshotId], references: [id])
  outgoingEdges     DependencyEdge[]   @relation("FromArtifact")
  incomingEdges     DependencyEdge[]   @relation("ToArtifact")
  evidences         Evidence[]
  traceabilityLinks TraceabilityLink[]
  embeddingChunks   EmbeddingChunk[]   @relation("EmbeddingChunkArtifact")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([snapshotId, artifactKey])
  @@unique([id, snapshotId])
  @@index([snapshotId, artifactType, artifactKey])
}

model DependencyEdge {
  id             String             @id @default(uuid())
  snapshotId     String
  fromArtifactId String
  toArtifactId   String
  type           DependencyEdgeType
  confidence     Float?
  metadata       Json?
  snapshot       RepositorySnapshot @relation(fields: [snapshotId], references: [id])
  fromArtifact   CodeArtifact       @relation("FromArtifact", fields: [fromArtifactId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Cascade)
  toArtifact     CodeArtifact       @relation("ToArtifact", fields: [toArtifactId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Cascade)
  createdAt      DateTime           @default(now())

  @@unique([snapshotId, fromArtifactId, toArtifactId, type])
  @@index([snapshotId, toArtifactId, type])
  @@index([snapshotId, fromArtifactId, type])
}

model Evidence {
  id                    String                 @id @default(uuid())
  provenanceKey         String
  sourceType            EvidenceSourceType
  snapshotId            String?
  artifactId            String?
  requirementRevisionId String?
  sourcePath            String?
  startLine             Int?
  endLine               Int?
  excerpt               String
  contentHash           String
  isRedacted            Boolean                @default(false)
  redactionMetadata     Json?
  snapshot              RepositorySnapshot?    @relation(fields: [snapshotId], references: [id])
  artifact              CodeArtifact?          @relation(fields: [artifactId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Cascade)
  requirementRevision   RequirementRevision?   @relation(fields: [requirementRevisionId], references: [id])
  insightEvidence       InsightEvidence[]
  traceabilityEvidence  TraceabilityEvidence[]
  createdAt             DateTime               @default(now())

  @@unique([provenanceKey])
  @@index([snapshotId, artifactId])
}

model Requirement {
  id                 String                 @id @default(uuid())
  projectId          String
  requestKey         String                 @default(uuid())
  requestPayloadHash String                 @default("")
  revisions          RequirementRevision[]
  analyses           ImpactAnalysis[]
  multiRepoRuns      MultiRepoAnalysisRun[]
  project            Project                @relation(fields: [projectId], references: [id])
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([id, projectId])
  @@unique([projectId, requestKey])
  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
}

model RequirementRevision {
  id                      String                     @id @default(uuid())
  requirementId           String
  title                   String
  rawText                 String
  normalizedText          String
  readinessStatus         RequirementReadinessStatus
  validationIssues        Json?
  requirement             Requirement                @relation(fields: [requirementId], references: [id])
  evidences               Evidence[]
  analyses                ImpactAnalysis[]
  multiRepoRuns           MultiRepoAnalysisRun[]
  convertedClarifications ClarificationItem[]        @relation("ConvertedClarifications")
  createdAt               DateTime                   @default(now())

  @@unique([id, requirementId])
  @@index([requirementId, createdAt(sort: Desc), id(sort: Desc)])
}

model MultiRepoAnalysisRun {
  id                        String                     @id @default(uuid())
  projectId                 String
  requirementId             String
  requirementRevisionId     String
  createdByUserId           String                     @db.Uuid
  requestKey                String
  requestPayloadHash        String?
  requestPlan               Json?
  requestedDomainPackId     String?
  resolvedDomainPackId      String                     @default("general")
  resolvedDomainPackVersion String                     @default("0.0.0")
  resolvedDomainPackStatus  DomainPackCapabilityStatus @default(FALLBACK)
  domainPackSelectedBy      DomainPackSelectionSource  @default(FALLBACK)
  domainPackResolvedAt      DateTime                   @default(now())
  domainPackManifestDigest  String?
  domainPackRegistryVersion String?
  project                   Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  requirement               Requirement                @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Cascade, onUpdate: Cascade)
  requirementRevision       RequirementRevision        @relation(fields: [requirementRevisionId, requirementId], references: [id, requirementId], onDelete: Cascade, onUpdate: Cascade)
  createdByUser             User                       @relation("CreatedMultiRepoRuns", fields: [createdByUserId], references: [id], onDelete: Cascade)
  analyses                  ImpactAnalysis[]
  approvedMergedReport      MergedMultiRepoReport?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@unique([projectId, requestKey])
  @@unique([id, projectId, requirementId, requirementRevisionId], map: "MultiRepoAnalysisRun_id_projectId_requirementId_requirementRevi")
  @@index([projectId])
  @@index([requirementRevisionId])
  @@index([createdByUserId])
  @@index([resolvedDomainPackId, resolvedDomainPackVersion], map: "MultiRepoAnalysisRun_resolvedDomainPackId_resolvedDomainPackVer")
}

model MergedMultiRepoReport {
  id              String                                @id @default(uuid())
  runId           String                                @unique
  content         String
  provenance      Json
  run             MultiRepoAnalysisRun                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  reviewDecisions MergedMultiRepoReportReviewDecision[]
  createdAt       DateTime                              @default(now())
  updatedAt       DateTime                              @updatedAt

  @@index([runId])
}

model MergedMultiRepoReportReviewDecision {
  id               String                      @id @default(uuid())
  mergedReportId   String
  decision         AnalysisReviewDecisionValue
  note             String?
  reviewedByUserId String                      @db.Uuid
  mergedReport     MergedMultiRepoReport       @relation(fields: [mergedReportId], references: [id], onDelete: Cascade)
  reviewedByUser   User                        @relation(fields: [reviewedByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime                    @default(now())

  @@index([mergedReportId])
  @@index([reviewedByUserId])
}

model ImpactAnalysis {
  id                          String                       @id @default(uuid())
  requirementRevisionId       String
  requirementId               String
  projectId                   String
  repositoryId                String
  snapshotId                  String
  sourceTargetId              String
  multiRepoRunId              String?
  requestKey                  String
  status                      ImpactAnalysisStatus
  stage                       ImpactAnalysisStage
  progress                    Int                          @default(0)
  acceptedPartialCoverage     Boolean                      @default(false)
  coverageWarning             String?
  requestedDomainPackId       String?
  resolvedDomainPackId        String                       @default("general")
  resolvedDomainPackVersion   String                       @default("0.0.0")
  resolvedDomainPackStatus    DomainPackCapabilityStatus   @default(FALLBACK)
  domainPackSelectedBy        DomainPackSelectionSource    @default(FALLBACK)
  domainPackResolvedAt        DateTime                     @default(now())
  domainPackManifestDigest    String?
  domainPackRegistryVersion   String?
  requirement                 Requirement                  @relation(fields: [requirementId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  requirementRevision         RequirementRevision          @relation(fields: [requirementRevisionId, requirementId], references: [id, requirementId], onDelete: Restrict, onUpdate: Cascade)
  repository                  Repository                   @relation(fields: [repositoryId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Cascade)
  snapshot                    RepositorySnapshot           @relation(fields: [snapshotId, repositoryId], references: [id, repositoryId], onDelete: Restrict, onUpdate: Cascade)
  sourceTarget                RepositoryTarget             @relation(fields: [sourceTargetId, repositoryId], references: [id, repositoryId], onDelete: Restrict, onUpdate: Cascade)
  multiRepoRun                MultiRepoAnalysisRun?        @relation(fields: [multiRepoRunId, projectId, requirementId, requirementRevisionId], references: [id, projectId, requirementId, requirementRevisionId], onDelete: Restrict, onUpdate: Cascade, map: "ImpactAnalysis_multiRepoRunId_projectId_requirementId_requireme")
  insights                    BaInsight[]
  traceabilityLinks           TraceabilityLink[]
  documents                   GeneratedDocument[]
  documentJobs                DocumentJob[]
  metadata                    Json?
  error                       Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  reviewNotes                 ReviewNote[]
  clarificationItems          ClarificationItem[]
  reviewDecisions             AnalysisReviewDecision[]
  traceabilityReviewDecisions TraceabilityReviewDecision[]
  reviewedReportSnapshots     ReviewedReportSnapshot[]

  // Traceability & Lineage
  derivedFromAnalysisId        String? @map("derived_from_analysis_id")
  sourceClarificationId        String? @map("source_clarification_id")
  reviewClarificationRequestId String? @map("review_clarification_request_id")

  derivedFromAnalysis        ImpactAnalysis?              @relation("ImpactAnalysisDerivation", fields: [derivedFromAnalysisId], references: [id])
  derivedAnalyses            ImpactAnalysis[]             @relation("ImpactAnalysisDerivation")
  sourceClarification        ClarificationItem?           @relation("ImpactAnalysisSourceClarification", fields: [sourceClarificationId], references: [id])
  reviewClarificationRequest ReviewClarificationRequest?  @relation("ImpactAnalysisReviewClarification", fields: [reviewClarificationRequestId], references: [id])
  clarificationRequests      ReviewClarificationRequest[] @relation("AnalysisToClarificationRequest")

  @@unique([requirementRevisionId, snapshotId, sourceTargetId, requestKey])
  @@unique([id, snapshotId])
  @@index([status, createdAt])
  @@index([requirementRevisionId])
  @@index([snapshotId])
  @@index([sourceTargetId])
  @@index([multiRepoRunId])
  @@index([derivedFromAnalysisId])
  @@index([sourceClarificationId])
  @@index([reviewClarificationRequestId])
  @@index([resolvedDomainPackId, resolvedDomainPackVersion], map: "ImpactAnalysis_resolvedDomainPackId_resolvedDomainPackVersion_i")
}

model BaInsight {
  id               String             @id @default(uuid())
  impactAnalysisId String
  insightKey       String
  insightType      InsightType
  certainty        InsightCertainty
  reviewStatus     ReviewStatus
  confidence       Float?
  title            String
  description      String
  reasoning        String?
  metadata         Json?
  impactAnalysis   ImpactAnalysis     @relation(fields: [impactAnalysisId], references: [id])
  evidenceLinks    InsightEvidence[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  reviewNote       ReviewNote?
  clarification    ClarificationItem?

  @@unique([impactAnalysisId, insightKey])
  @@unique([id, impactAnalysisId])
  @@index([impactAnalysisId])
  @@index([impactAnalysisId, reviewStatus])
  @@index([impactAnalysisId, certainty])
  @@index([impactAnalysisId, insightType])
}

model InsightEvidence {
  id         String    @id @default(uuid())
  insightId  String
  evidenceId String
  insight    BaInsight @relation(fields: [insightId], references: [id])
  evidence   Evidence  @relation(fields: [evidenceId], references: [id])

  @@unique([insightId, evidenceId])
}

model TraceabilityLink {
  id                String                      @id @default(uuid())
  impactAnalysisId  String
  snapshotId        String
  artifactId        String
  linkType          TraceabilityLinkType
  linkBasis         TraceabilityLinkBasis
  reviewStatus      ReviewStatus
  confidence        Float?
  impactAnalysis    ImpactAnalysis              @relation(fields: [impactAnalysisId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Cascade)
  artifact          CodeArtifact                @relation(fields: [artifactId, snapshotId], references: [id, snapshotId], onDelete: Restrict, onUpdate: Cascade)
  evidenceLinks     TraceabilityEvidence[]
  retrievalMetadata Json?                       @map("retrieval_metadata")
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  reviewNote        ReviewNote?
  reviewDecision    TraceabilityReviewDecision?

  @@unique([impactAnalysisId, artifactId, linkType])
  @@unique([id, impactAnalysisId])
  @@index([impactAnalysisId])
  @@index([impactAnalysisId, reviewStatus])
  @@index([snapshotId])
  @@index([artifactId])
}

model TraceabilityReviewDecision {
  id                 String                          @id @default(uuid())
  analysisId         String                          @map("analysis_id")
  traceabilityLinkId String                          @unique @map("traceability_link_id")
  decision           TraceabilityReviewDecisionValue
  note               String?
  reviewedByUserId   String?                         @map("reviewed_by_user_id") @db.Uuid
  reviewedAt         DateTime                        @default(now()) @map("reviewed_at")
  createdAt          DateTime                        @default(now()) @map("created_at")
  updatedAt          DateTime                        @updatedAt @map("updated_at")

  analysis         ImpactAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  traceabilityLink TraceabilityLink @relation(fields: [traceabilityLinkId, analysisId], references: [id, impactAnalysisId], onDelete: Cascade, onUpdate: Cascade, map: "traceability_review_decision_traceability_link_id_analysis_id_f")
  reviewedByUser   User?            @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@unique([traceabilityLinkId, analysisId], map: "traceability_review_decision_traceability_link_id_analysis_id_k")
  @@index([analysisId])
  @@index([reviewedByUserId])
  @@map("traceability_review_decision")
}

model TraceabilityEvidence {
  id                 String           @id @default(uuid())
  traceabilityLinkId String
  evidenceId         String
  traceabilityLink   TraceabilityLink @relation(fields: [traceabilityLinkId], references: [id])
  evidence           Evidence         @relation(fields: [evidenceId], references: [id])

  @@unique([traceabilityLinkId, evidenceId])
}

model GeneratedDocument {
  id                       String                    @id @default(uuid())
  impactAnalysisId         String
  reviewedReportSnapshotId String?                   @map("reviewed_report_snapshot_id")
  type                     DocumentType
  status                   DocumentStatus
  content                  String
  impactAnalysis           ImpactAnalysis            @relation(fields: [impactAnalysisId], references: [id])
  reviewedReportSnapshot   ReviewedReportSnapshot?   @relation("GeneratedDocumentSnapshot", fields: [reviewedReportSnapshotId, impactAnalysisId], references: [id, analysisId], onDelete: Restrict, onUpdate: Cascade, map: "GeneratedDocument_reviewed_report_snapshot_id_impactAnalysisId_")
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  reviewedSnapshots        ReviewedReportSnapshot[]  @relation("SnapshotApprovedDocument")
  documentJobs             DocumentJob[]
  localizedArtifacts       LocalizedReportArtifact[]

  @@unique([id, impactAnalysisId])
  @@unique([reviewedReportSnapshotId, type, status], map: "GeneratedDocument_reviewedReportSnapshotId_type_status_key")
  @@index([impactAnalysisId, status])
}

model LocalizedReportArtifact {
  id               String            @id @default(uuid())
  sourceDocumentId String
  sourceDocument   GeneratedDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Cascade)

  locale             String // BCP-47 locale tag, e.g. "vi-VN"
  sourceLocale       String             @default("en")
  localizationStatus LocalizationStatus

  contentMarkdown   String?
  sourceContentHash String // Computed from canonical JSON serialization

  // Metadata for tracing and debugging
  glossaryVersion            String?
  provider                   String?
  model                      String?
  translationPromptVersion   String?
  structuralValidatorVersion String?
  fieldPolicyVersion         String?

  errorCode String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sourceDocumentId, locale])
  @@index([sourceDocumentId])
  @@index([locale])
  @@index([localizationStatus])
}

model DocumentJob {
  id           String            @id @default(uuid())
  analysisId   String            @map("analysis_id")
  snapshotId   String            @map("snapshot_id")
  documentType DocumentType      @map("document_type")
  status       DocumentJobStatus
  progress     Int               @default(0)
  requestKey   String?           @map("request_key")
  attemptCount Int               @default(0) @map("attempt_count")
  error        Json?

  generatedDocumentId           String? @map("generated_document_id")
  generatedDocumentAnalysisId   String? @map("generated_document_analysis_id")

  analysis          ImpactAnalysis         @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  snapshot          ReviewedReportSnapshot @relation(fields: [snapshotId, analysisId], references: [id, analysisId], onDelete: Cascade, onUpdate: Cascade)
  generatedDocument GeneratedDocument?     @relation(fields: [generatedDocumentId, generatedDocumentAnalysisId], references: [id, impactAnalysisId], onDelete: SetNull, onUpdate: Cascade, map: "document_job_generated_document_analysis_scope_fkey")

  lastStartedAt DateTime? @map("last_started_at")
  completedAt   DateTime? @map("completed_at")
  failedAt      DateTime? @map("failed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@unique([snapshotId, documentType])
  @@index([analysisId])
  @@index([status])
  @@index([requestKey])
  @@map("document_job")
}

model ReviewedReportSnapshot {
  id                             String   @id @default(uuid())
  analysisId                     String   @map("analysis_id")
  approvedDocumentId             String?  @map("approved_document_id")
  approvedDocumentAnalysisId     String?  @map("approved_document_analysis_id")
  markdown                       String?
  reviewDecisionsSnapshot        Json     @map("review_decisions_snapshot")
  clarificationsSnapshot         Json?    @map("clarifications_snapshot")
  evidenceQualitySummarySnapshot Json     @map("evidence_quality_summary_snapshot")
  evaluationContextSnapshot      Json?    @map("evaluation_context_snapshot")
  testTraceSnapshot              Json?    @map("test_trace_snapshot")
  createdByUserId                String?  @map("created_by_user_id") @db.Uuid
  createdAt                      DateTime @default(now()) @map("created_at")

  analysis           ImpactAnalysis      @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  approvedDocument   GeneratedDocument?  @relation("SnapshotApprovedDocument", fields: [approvedDocumentId, approvedDocumentAnalysisId], references: [id, impactAnalysisId], onDelete: SetNull, onUpdate: Cascade, map: "reviewed_report_snapshot_approved_document_id_analysis_id_fkey")
  generatedDocuments GeneratedDocument[] @relation("GeneratedDocumentSnapshot")
  createdByUser      User?               @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  documentJobs       DocumentJob[]

  @@unique([id, analysisId])
  @@index([analysisId, createdAt])
  @@map("reviewed_report_snapshot")
}

model DomainEvent {
  id             String   @id @default(uuid())
  eventType      String
  idempotencyKey String
  payload        Json
  createdAt      DateTime @default(now())

  @@unique([idempotencyKey])
  @@index([eventType, createdAt])
}

model ReviewNote {
  id                 String   @id @default(uuid())
  impactAnalysisId   String   @map("impact_analysis_id")
  insightId          String?  @unique @map("insight_id")
  traceabilityLinkId String?  @unique @map("traceability_link_id")
  body               String
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  impactAnalysis   ImpactAnalysis    @relation(fields: [impactAnalysisId], references: [id], onDelete: Cascade)
  insight          BaInsight?        @relation(fields: [insightId, impactAnalysisId], references: [id, impactAnalysisId], onDelete: Cascade, onUpdate: Cascade)
  traceabilityLink TraceabilityLink? @relation(fields: [traceabilityLinkId, impactAnalysisId], references: [id, impactAnalysisId], onDelete: Cascade, onUpdate: Cascade)

  @@unique([impactAnalysisId, insightId])
  @@unique([impactAnalysisId, traceabilityLinkId])
  @@unique([insightId, impactAnalysisId])
  @@unique([traceabilityLinkId, impactAnalysisId])
  @@index([impactAnalysisId])
  @@index([insightId])
  @@index([traceabilityLinkId])
  @@map("review_note")
}

model ClarificationItem {
  id                             String              @id @default(uuid())
  impactAnalysisId               String              @map("impact_analysis_id")
  sourceInsightId                String              @map("source_insight_id")
  question                       String
  reason                         String?
  status                         ClarificationStatus @default(OPEN)
  answer                         String?
  convertedRequirementRevisionId String?             @unique @map("converted_revision_id")
  createdAt                      DateTime            @default(now()) @map("created_at")
  updatedAt                      DateTime            @updatedAt @map("updated_at")

  impactAnalysis    ImpactAnalysis       @relation(fields: [impactAnalysisId], references: [id], onDelete: Cascade)
  sourceInsight     BaInsight            @relation(fields: [sourceInsightId, impactAnalysisId], references: [id, impactAnalysisId], onDelete: Cascade, onUpdate: Cascade)
  convertedRevision RequirementRevision? @relation("ConvertedClarifications", fields: [convertedRequirementRevisionId], references: [id])
  derivedAnalyses   ImpactAnalysis[]     @relation("ImpactAnalysisSourceClarification")

  @@index([impactAnalysisId])
  @@index([status])
  @@unique([sourceInsightId, impactAnalysisId])
  @@map("clarification_item")
}

model AnalysisReviewDecision {
  id               String                      @id @default(uuid())
  analysisId       String                      @map("analysis_id")
  decision         AnalysisReviewDecisionValue
  note             String?
  reviewedByUserId String                      @map("reviewed_by_user_id") @db.Uuid
  createdAt        DateTime                    @default(now()) @map("created_at")

  analysis              ImpactAnalysis               @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  reviewedByUser        User                         @relation(fields: [reviewedByUserId], references: [id])
  clarificationRequests ReviewClarificationRequest[]

  @@unique([id, analysisId])
  @@index([analysisId, createdAt])
  @@map("analysis_review_decision")
}

model ReviewClarificationRequest {
  id               String @id @default(uuid())
  analysisId       String @map("analysis_id")
  reviewDecisionId String @map("review_decision_id")

  question String
  answer   String?

  status ReviewClarificationStatus @default(OPEN)

  createdByUserId  String    @map("created_by_user_id") @db.Uuid
  answeredByUserId String?   @map("answered_by_user_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")
  answeredAt       DateTime? @map("answered_at")
  cancelledAt      DateTime? @map("cancelled_at")

  analysis       ImpactAnalysis         @relation("AnalysisToClarificationRequest", fields: [analysisId], references: [id], onDelete: Cascade)
  reviewDecision AnalysisReviewDecision @relation(fields: [reviewDecisionId, analysisId], references: [id, analysisId], onDelete: Cascade, onUpdate: Cascade, map: "review_clarification_request_review_decision_id_analysis_id_fke")
  createdByUser  User                   @relation("ClarificationCreatedBy", fields: [createdByUserId], references: [id])
  answeredByUser User?                  @relation("ClarificationAnsweredBy", fields: [answeredByUserId], references: [id])

  derivedAnalyses ImpactAnalysis[] @relation("ImpactAnalysisReviewClarification")

  @@index([analysisId, createdAt])
  @@index([reviewDecisionId])
  @@map("review_clarification_request")
}

// =======================
// Embedding / RAG
// =======================

model EmbeddingChunk {
  // Isolation scope: MVP tenantId = projectId; future = organizationId
  id           String  @id @default(uuid())
  tenantId     String
  projectId    String
  repositoryId String
  snapshotId   String
  artifactId   String?

  // Stable identifier for idempotent upserts: "artifact:<stableId>:<contentHash>"
  stableChunkId String

  commitSha    String
  filePath     String
  symbolName   String?
  artifactType String

  content        String
  contentHash    String
  tokenCount     Int
  chunkerVersion String?

  embeddingModel String
  embedding      Unsupported("vector(1536)")

  repository Repository         @relation("EmbeddingChunkRepository", fields: [repositoryId, projectId], references: [id, projectId], onDelete: Restrict)
  snapshot   RepositorySnapshot @relation("EmbeddingChunkSnapshot", fields: [snapshotId, repositoryId, commitSha], references: [id, repositoryId, commitSha], onDelete: Cascade)
  artifact   CodeArtifact?      @relation("EmbeddingChunkArtifact", fields: [artifactId, snapshotId], references: [id, snapshotId], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@unique([snapshotId, stableChunkId, embeddingModel])
  @@index([tenantId])
  @@index([projectId])
  @@index([repositoryId])
  @@index([snapshotId])
  @@index([artifactId])
  @@index([commitSha])
}
