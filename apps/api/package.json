  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm exec ts-node -r tsconfig-paths/register --project tsconfig.json src/main.ts",
    "lint": "echo \"lint api\"",
    "smoke:public-github": "tsx src/smoke-e2e.ts",
