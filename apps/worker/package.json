  "dependencies": {
    "@ba-helper/application": "workspace:*",
    "@ba-helper/backend-runtime": "workspace:*",
    "@ba-helper/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/core": "11.1.24",
    "bullmq": "5.77.6",
    "dotenv": "^17.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  }
}
