{
  "name": "@ba-helper/worker",
  "version": "0.1.0",
  "private": true,
  "main": "dist/apps/worker/src/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "dotenv -e ../../.env -- pnpm exec ts-node -r tsconfig-paths/register --project tsconfig.json src/main.ts",
