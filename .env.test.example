# Local automated tests only. PostgreSQL must have the pgvector extension available.
DATABASE_URL_TEST=postgresql://ba_helper:ba_helper@localhost:5432/ba_helper_test
REDIS_URL_TEST=redis://localhost:6379/1
WORKSPACE_MODE=dev-single-user
ENABLE_DEV_LOGIN=true
JWT_SECRET=local-test-only-jwt-secret-do-not-use-in-production
NEXTAUTH_SECRET=local-test-only-nextauth-secret-do-not-use-in-production
AI_PROVIDER=fake
EMBEDDING_PROVIDER=fake
NEXT_PUBLIC_USE_MOCK_API=false
