{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reqimpact.local/evaluation/datasets/cases.v0.schema.json",
  "title": "ReqImpact evaluation dataset v0",
  "type": "object",
  "additionalProperties": false,
  "required": ["cases"],
  "properties": {
    "version": {
      "const": "cases.v0"
    },
    "generatedBy": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReqImpactEvaluationCase"
      }
    }
  },
  "$defs": {
    "GroundTruth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files"],
      "properties": {
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "CandidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactKey", "filePath", "artifactName", "artifactType"],
      "properties": {
        "artifactKey": {
          "type": "string",
          "minLength": 1
        },
        "filePath": {
          "type": "string",
          "minLength": 1
        },
        "artifactName": {
          "type": "string",
          "minLength": 1
        },
        "artifactType": {
          "type": "string",
          "minLength": 1
        },
        "universalKind": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": "string"
        }
      }
    },
    "ReqImpactEvaluationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "repo",
        "baseSha",
        "requirementText",
        "groundTruth",
        "candidateArtifacts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "repo": {
          "type": "string",
          "minLength": 1
        },
        "issueUrl": {
          "type": "string",
          "format": "uri"
        },
        "prUrl": {
          "type": "string",
          "format": "uri"
        },
        "baseSha": {
          "type": "string",
          "minLength": 1
        },
        "headSha": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "minLength": 1
        },
        "requirementText": {
          "type": "string",
          "minLength": 1
        },
        "groundTruth": {
          "$ref": "#/$defs/GroundTruth"
        },
        "candidateArtifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/CandidateArtifact"
          }
        },
        "evaluationScope": {
          "type": "string",
          "minLength": 1
        },
        "scannerCoverageNote": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
