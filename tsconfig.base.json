{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@ba-helper/contracts": ["packages/contracts/src/index.ts"],
      "@ba-helper/shared": ["packages/shared/src/index.ts"],
      "@ba-helper/analyzer": ["packages/analyzer/src/index.ts"],
      "@ba-helper/application": ["packages/application/src/index.ts"],
      "@ba-helper/application/document": ["packages/application/src/document/index.ts"],
      "@ba-helper/application/embedding": ["packages/application/src/embedding/index.ts"],
      "@ba-helper/application/impact-analysis": ["packages/application/src/impact-analysis/index.ts"],
      "@ba-helper/application/scanner": ["packages/application/src/scanner/index.ts"],
      "@ba-helper/backend-runtime": ["packages/backend-runtime/src/index.ts"],
      "@ba-helper/backend-runtime/ai": ["packages/backend-runtime/src/ai/index.ts"],
      "@ba-helper/backend-runtime/document": ["packages/backend-runtime/src/document/index.ts"],
      "@ba-helper/backend-runtime/embedding": ["packages/backend-runtime/src/embedding/index.ts"],
      "@ba-helper/backend-runtime/prisma": ["packages/backend-runtime/src/prisma/index.ts"],
      "@ba-helper/backend-runtime/queue": ["packages/backend-runtime/src/queue/index.ts"],
      "@ba-helper/backend-runtime/scanner": ["packages/backend-runtime/src/scanner/index.ts"],
      "@prisma/client": ["apps/api/node_modules/.prisma/client/index.d.ts"]
    },
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": false
  }
}
