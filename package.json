{
  "name": "ba-helper",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "scripts": {
    "build": "pnpm -r build",
    "db:migrate": "pnpm --dir apps/api exec prisma migrate deploy",
    "db:seed:demo": "pnpm --dir apps/api exec tsx prisma/seed.demo.ts",
    "demo:golden-path": "jest --config jest.config.ts --runInBand tests/demo/golden-path-demo.spec.ts",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "eval:probe:db": "ts-node --project tsconfig.json evaluation/scripts/probe-db-snapshot-readiness.ts",
    "eval:probe:vector-path": "ts-node --project tsconfig.json evaluation/scripts/probe-vector-baseline-path.ts",
    "eval:alignment": "ts-node --project tsconfig.json evaluation/scripts/check-case-snapshot-alignment.ts",
    "eval:baseline:keyword": "ts-node --project tsconfig.json evaluation/scripts/run-keyword-baseline.ts",
    "eval:baseline:bm25": "ts-node --project tsconfig.json evaluation/scripts/run-bm25-baseline.ts",
    "eval:samples": "ts-node --project tsconfig.json evaluation/scripts/run-samples.ts",
    "eval:analyze": "ts-node --project tsconfig.json evaluation/scripts/analyze-failures.ts",
    "eval:metrics": "ts-node --project tsconfig.json evaluation/scripts/compute-metrics.ts",
    "eval:research-summary": "ts-node --project tsconfig.json evaluation/scripts/run-evaluation.ts",
    "eval:validate": "ts-node --project tsconfig.json evaluation/scripts/validate-results.ts",
    "eval:pipeline:v0": "pnpm eval:probe:db && pnpm eval:probe:vector-path && pnpm eval:alignment && pnpm eval:baseline:keyword && pnpm eval:baseline:bm25 && pnpm eval:samples && pnpm eval:metrics && pnpm eval:analyze && pnpm eval:research-summary && pnpm eval:validate",
    "eval:vector:probe:case006": "ts-node --project tsconfig.json evaluation/scripts/probe-vector-only.ts --caseId reqimpact-case-006-squareboat-default-includes",
    "eval:subset:clean-vector-ready": "ts-node --project tsconfig.json evaluation/scripts/build-clean-vector-ready-subset.ts",
    "eval:baseline:vector": "ts-node --project tsconfig.json evaluation/scripts/run-vector-baseline.ts --subset clean-vector-ready-v0",
    "eval:baseline:hybrid:clean-subset": "ts-node --project tsconfig.json evaluation/scripts/run-current-hybrid-baseline.ts --subset clean-vector-ready-v0",
    "eval:baseline:keyword:clean-subset": "ts-node --project tsconfig.json evaluation/scripts/run-keyword-clean-subset-baseline.ts --subset clean-vector-ready-v0",
    "eval:baseline:bm25:clean-subset": "ts-node --project tsconfig.json evaluation/scripts/run-bm25-clean-subset-baseline.ts --subset clean-vector-ready-v0",
    "eval:comparison:same-subset": "ts-node --project tsconfig.json evaluation/scripts/build-same-subset-comparison.ts --subset clean-vector-ready-v0",
    "eval:analysis:e13": "ts-node --project tsconfig.json evaluation/scripts/build-e13-research-findings.ts",
    "eval:e11a": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:vector:probe:case006 && pnpm eval:validate",
    "eval:e11b": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:validate",
    "eval:e11c": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:baseline:vector && pnpm eval:validate",
    "eval:e12a": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:baseline:vector && pnpm eval:baseline:hybrid:clean-subset && pnpm eval:validate",
    "eval:e12b": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:baseline:vector && pnpm eval:baseline:hybrid:clean-subset && pnpm eval:baseline:keyword:clean-subset && pnpm eval:baseline:bm25:clean-subset && pnpm eval:validate",
    "eval:e12c": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:baseline:vector && pnpm eval:baseline:hybrid:clean-subset && pnpm eval:baseline:keyword:clean-subset && pnpm eval:baseline:bm25:clean-subset && pnpm eval:comparison:same-subset && pnpm eval:validate",
    "eval:e13": "pnpm eval:validate && pnpm eval:analysis:e13 && pnpm eval:validate",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis",
    "lint": "pnpm -r lint",
    "smoke:public-github": "pnpm --dir apps/api smoke:public-github",
    "test": "jest --config jest.config.ts --runInBand",
    "test:ci": "jest --config jest.ci.config.ts --runInBand",
    "test:analyzer": "jest --config jest.analyzer.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "test:e2e:watch": "jest --config jest.e2e.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@prisma/client": "7.8.0",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "canonicalize": "^2.1.0",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "msw": "^1.3.3",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.5",
    "undici": "^8.5.0",
    "whatwg-fetch": "^3.6.20",
    "zod": "3.23.8"
  },
  "dependencies": {
    "@ba-helper/contracts": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
