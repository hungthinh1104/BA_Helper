{
  "name": "ba-helper",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.5.1+sha512.93f7b57422ea7068257235b4c16eb60762eb68e1dc23723199cc739043ea9be2c4143274a399d8c6defa2b1176226d9ca1c4b63482d6200c1a8fbaa78c1d1485",
  "scripts": {
    "build": "pnpm -r build",
    "demo:golden-path": "jest --config jest.config.ts --runInBand tests/demo/golden-path-demo.spec.ts",
    "dev:api": "pnpm --dir apps/api dev",
    "dev:web": "pnpm --dir apps/web dev",
    "dev:worker": "pnpm --dir apps/worker dev",
    "eval:probe:db": "ts-node --project tsconfig.json evaluation/scripts/probe-db-snapshot-readiness.ts",
    "eval:probe:vector-path": "ts-node --project tsconfig.json evaluation/scripts/probe-vector-baseline-path.ts",
    "eval:alignment": "ts-node --project tsconfig.json evaluation/scripts/check-case-snapshot-alignment.ts",
    "eval:baseline:keyword": "ts-node --project tsconfig.json evaluation/scripts/run-keyword-baseline.ts",
    "eval:baseline:bm25": "ts-node --project tsconfig.json evaluation/scripts/run-bm25-baseline.ts",
    "eval:samples": "ts-node --project tsconfig.json evaluation/scripts/run-samples.ts",
    "eval:analyze": "ts-node --project tsconfig.json evaluation/scripts/analyze-failures.ts",
    "eval:metrics": "ts-node --project tsconfig.json evaluation/scripts/compute-metrics.ts",
    "eval:research-summary": "ts-node --project tsconfig.json evaluation/scripts/run-evaluation.ts",
    "eval:validate": "ts-node --project tsconfig.json evaluation/scripts/validate-results.ts",
    "eval:pipeline:v0": "pnpm eval:probe:db && pnpm eval:probe:vector-path && pnpm eval:alignment && pnpm eval:baseline:keyword && pnpm eval:baseline:bm25 && pnpm eval:samples && pnpm eval:metrics && pnpm eval:analyze && pnpm eval:research-summary && pnpm eval:validate",
    "eval:vector:probe:case006": "ts-node --project tsconfig.json evaluation/scripts/probe-vector-only.ts --caseId reqimpact-case-006-squareboat-default-includes",
    "eval:subset:clean-vector-ready": "ts-node --project tsconfig.json evaluation/scripts/build-clean-vector-ready-subset.ts",
    "eval:e11a": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:vector:probe:case006 && pnpm eval:validate",
    "eval:e11b": "pnpm eval:probe:db && pnpm eval:alignment && pnpm eval:subset:clean-vector-ready && pnpm eval:validate",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis",
    "lint": "pnpm -r lint",
    "smoke:public-github": "pnpm --dir apps/api smoke:public-github",
    "test": "jest --config jest.config.ts --runInBand",
    "test:ci": "jest --config jest.ci.config.ts --runInBand",
    "test:analyzer": "jest --config jest.analyzer.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "test:e2e:watch": "jest --config jest.e2e.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.24",
    "@prisma/client": "7.8.0",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "canonicalize": "^2.1.0",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "prettier": "3.8.3",
    "supertest": "^7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.4.5",
    "zod": "3.23.8"
  },
  "dependencies": {
    "@ba-helper/contracts": "workspace:*"
  }
}
