{
  "name": "ba-helper",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.6+sha512.55d90390c3b39042f1505a2697789f0256c6d95bb28bdd7cb731af1887c9f2629ef581acb9f4e4ec772024c8203c2aed22a03299b97103fdcf32668e905d0024",
  "scripts": {
    "build": "dotenv -e .env -- pnpm -r build",
    "db:migrate": "dotenv -e .env -- pnpm --dir apps/api exec prisma migrate deploy",
    "db:seed:demo": "dotenv -e .env -- pnpm --dir apps/api exec tsx prisma/seed.demo.ts",
    "demo:golden-path": "jest --config jest.config.ts --runInBand tests/demo/golden-path-demo.spec.ts",
    "demo:multi-repo-golden-path": "jest --config jest.config.ts --runInBand tests/demo/multi-repo-golden-path-demo.spec.ts",
    "dev:api": "dotenv -e .env -- pnpm --dir apps/api dev",
    "dev:web": "dotenv -e .env -- pnpm --dir apps/web dev",
    "dev:worker": "dotenv -e .env -- pnpm --dir apps/worker dev",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d postgres redis",
    "lint": "pnpm -r lint",
    "smoke:public-github": "dotenv -e .env -- pnpm --dir apps/api smoke:public-github",
    "test": "jest --config jest.config.ts --runInBand",
    "test:ci": "jest --config jest.ci.config.ts --runInBand",
    "test:analyzer": "jest --config jest.analyzer.config.ts",
    "test:unit": "jest --config jest.unit.config.ts",
    "test:integration": "jest --config jest.integration.config.ts",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e": "jest --config jest.e2e.config.ts --runInBand",
    "test:e2e:watch": "jest --config jest.e2e.config.ts --watch",
    "test:pw": "playwright test",
    "test:pw:report": "playwright show-report e2e/.artifacts/report",
    "typecheck": "pnpm typecheck:backend && pnpm typecheck:web && pnpm typecheck:scripts",
    "typecheck:backend": "tsc --noEmit",
    "typecheck:web": "pnpm --filter @ba-helper/contracts build && pnpm --filter @ba-helper/shared build && pnpm --dir apps/web typecheck",
    "typecheck:scripts": "tsc --noEmit --project tsconfig.scripts.json",
    "verify:domain-packs": "tsx scripts/verify-domain-packs.ts",
    "verify:dependencies": "pnpm audit --prod --audit-level=high",
    "benchmark:static-test-graph": "tsx scripts/benchmark-static-test-graph.ts",
    "verify:analyzer-quality": "tsx scripts/run-analyzer-quality-gate.ts",
    "verify:public-test-trace": "tsx scripts/verify-public-test-trace.ts",
    "verify:application-test-trace": "tsx scripts/evaluate-application-test-trace.ts",
    "prove:pinned-comprehension": "ts-node --transpile-only scripts/prove-pinned-code-comprehension.ts",
    "verify:pinned-comprehension-browser": "ts-node --transpile-only scripts/run-pinned-comprehension-browser.ts",
    "validate:product-beta": "tsx scripts/run-product-validation-scorecard.ts",
    "verify:controlled-beta-readiness": "tsx scripts/verify-controlled-beta-readiness.ts",
    "verify:release-drill": "tsx scripts/run-release-drill.ts",
    "verify:migration-upgrade": "tsx scripts/verify-migration-upgrade.ts",
    "verify:saas-entry": "tsx scripts/verify-saas-entry.ts",
    "verify:architecture-boundaries": "tsx scripts/verify-architecture-boundaries.ts && pnpm verify:backend-runtime-boundary",
    "verify:backend-runtime-boundary": "tsx scripts/verify-backend-runtime-boundary.ts",
    "verify:backend-runtime-http-boundary": "ts-node --transpile-only scripts/verify-backend-runtime-http-boundary.ts",
    "verify:stability": "pnpm verify:dependencies && pnpm infra:up && pnpm db:migrate && pnpm verify:migration-upgrade && pnpm verify:domain-packs && pnpm verify:analyzer-quality && pnpm verify:public-test-trace && pnpm verify:application-test-trace && pnpm verify:architecture-boundaries && pnpm verify:release-drill && pnpm verify:controlled-beta-readiness && pnpm typecheck && pnpm lint && pnpm test && pnpm test:web && pnpm test:e2e && pnpm demo:golden-path && pnpm demo:multi-repo-golden-path && pnpm test:pw"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@nestjs/testing": "11.2.7",
    "@playwright/test": "1.62.0",
    "@prisma/client": "7.10.1",
    "@swc/core": "1.15.40",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "^22",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.4.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "msw": "^1.3.5",
    "prettier": "3.8.3",
    "supertest": "^7.3.1",
    "ts-node": "10.9.2",
    "ts-morph": "28.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "undici": "^8.12.3",
    "whatwg-fetch": "^3.6.20",
    "zod": "4.6.7"
  },
  "dependencies": {
    "@ba-helper/backend-runtime": "workspace:*",
    "@ba-helper/contracts": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
